{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.2",
  "small_model": "opencode/minimax-m3",
  "subagent_depth": 1,
  "compaction": { "auto": true, "prune": true, "reserved": 10000 },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".next/**",
      ".next-docs/**",
      ".git/**",
      "tsconfig.tsbuildinfo",
      "pnpm-lock.yaml",
      ".agent/**",
      ".claude/**"
    ]
  },
  "provider": {
    "opencode": { "options": { "setCacheKey": true } }
  },
  "agent": {
    "explore": {
      "description": "Fast read-only codebase exploration on a cheaper model.",
      "model": "opencode/minimax-m3",
      "tools": { "write": false, "edit": false }
    }
  },
  "permission": { "edit": "ask", "bash": { "*": "ask" } }
}